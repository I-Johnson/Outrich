# ==============================================================================
# Outreach Pipeline Environment Configuration Template
# Copy this file to .env and fill in the values for your environment:
#   cp .env.example .env
# ==============================================================================

# --- Database Configuration ---
# Options: "supabase" (production/cloud) or "sqlite" (local testing)
DATABASE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DB_PATH=data/outreach.db

# --- Admin Authentication & Session ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-secure-password
SESSION_SECRET=change-me-to-a-random-32-byte-secret
SECRET_KEY=change-me-to-a-random-secret-key
# 32-byte urlsafe base64 key for encrypting stored credentials in DB:
ENCRYPTION_KEY=your-fernet-encryption-key-here

# --- App URL & Domain Identity ---
PUBLIC_BASE_URL=http://localhost:8080
FROM_DOMAIN=contractorops.ai
REPLY_TO=hello@contractorops.ai
COMPANY_NAME=ContractorOps
COMPANY_ADDRESS=39307 Lago Dr, Magnolia, TX 77354
INCLUDE_FOOTER=false

# --- Email Provider ---
# Options: "gmail" or "pingram"
EMAIL_PROVIDER=gmail
DRY_RUN=false

# --- Gmail Accounts (When using Gmail Provider) ---
# Supports up to 5 Gmail accounts: GMAIL_USER, GMAIL_USER_2, ... GMAIL_USER_5
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-google-app-password
GMAIL_USER_2=
GMAIL_APP_PASSWORD_2=
# Options: "direct" (SMTP directly) or "supabase" (reads credentials from DB)
GMAIL_TRANSPORT=supabase

# --- Pingram API (When using Pingram Provider) ---
PINGRAM_API_KEY=pingram_sk_your_api_key_here
PINGRAM_API_URL=https://api.pingram.io/email
PINGRAM_NOTIFICATION_TYPE=outreach_campaign

# --- AI Copywriting & Cleaning ---
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# --- Geocoding (Mapbox) ---
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here

# --- Search & Scraper Providers ---
SERP_PROVIDER=serper
SERP_API_KEY=your_serper_api_key_here

# --- Sending Windows & Scheduling ---
TIMEZONE=America/Chicago
SEND_START_HOUR=9
SEND_END_HOUR=17
# Days of week: 0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday
SEND_DAYS=0,1,2,3,4
MIN_GAP_MIN=7
MAX_GAP_MIN=35
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MIN=2
