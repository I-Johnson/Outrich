    },
    {
      "body": "Thirty pallets of manufactured components.",
      "expect": {
        "action": [
          "draft"
        ]
      }
    },
    {
      "body": "Please hold while I get customer approval",
      "expect": {
        "action": [
          "draft"
        ]
      }
    }
  ]
