  "turns": [
    {
      "body": "True team?",
      "expect": {
        "action": [
          "sent"
        ]
      }
    },
    {
      "body": "Can do 3450",
      "expect": {
        "action": [
          "sent"
        ]
      }
    },
    {
      "body": "Could you meet me at $4,200?",
      "expect": {
        "action": [
          "sent"
        ]
      }
    },
    {
      "body": "What are the delivery schedules?",
      "expect": {
        "action": [
          "draft"
        ],
        "draft_reason": "clarify_load_details"
